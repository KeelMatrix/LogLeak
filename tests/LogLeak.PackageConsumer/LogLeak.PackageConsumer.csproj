<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>LogLeak.PackageConsumer</AssemblyName>
    <RootNamespace>LogLeak.PackageConsumer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../docs/examples/SourceGeneratedLoggingExample.cs" Link="Documentation/SourceGeneratedLoggingExample.cs" />
    <PackageReference Include="KeelMatrix.LogLeak" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <PackageReference Include="KeelMatrix.Telemetry" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <Reference Include="KeelMatrix.LogLeak">
      <HintPath>$(PkgKeelMatrix_LogLeak)/lib/netstandard2.0/KeelMatrix.LogLeak.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="$(PkgKeelMatrix_LogLeak)/lib/netstandard2.0/KeelMatrix.LogLeak.dll"
          Link="consumer-assets/netstandard2.0/KeelMatrix.LogLeak.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
